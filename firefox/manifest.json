{
  "manifest_version": 3,
  "name": "Copy Text",
  "version": "1.0.0",
  "description": "Enables text selection and copying on websites that block it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-text@tkno",
      "strict_min_version": "128.0"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}